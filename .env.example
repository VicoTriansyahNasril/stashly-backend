# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.
# Server menolak start jika variabel wajib (DATABASE_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# ALLOWED_ORIGIN, STREAM_TOKEN_SECRET) belum diisi.

# ── Database ─────────────────────────────────────────────
# Harus database yang SAMA dengan frontend (NextAuth menyimpan user & sesi di sana).
DATABASE_URL="postgresql://postgres:password@localhost:5432/stashly"

# ── Google OAuth ─────────────────────────────────────────
# Sama persis dengan GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET di frontend.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Server ───────────────────────────────────────────────
# URL frontend persis (tanpa garis miring di akhir). Dipakai untuk CORS, proteksi CSRF,
# dan frame-ancestors (preview PDF).
ALLOWED_ORIGIN="http://localhost:3000"
PORT=3001

# Set true hanya jika API berada di belakang reverse proxy tepercaya (Render, Nginx, Cloudflare, dll)
# agar IP untuk rate limit diambil dari X-Forwarded-For. Jika tidak ada proxy, biarkan false.
TRUST_PROXY=false

# ── Secrets ──────────────────────────────────────────────
# Buat masing-masing dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Menandatangani token akses file berpassword (minimal 32 karakter).
STREAM_TOKEN_SECRET=""
# Scheduler wajib mengirim header "Authorization: Bearer <CRON_SECRET>" ke POST /cron/cleanup-trash
# (minimal 16 karakter). Jika kosong, endpoint cron nonaktif.
CRON_SECRET=""
